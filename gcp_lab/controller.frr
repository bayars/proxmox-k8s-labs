frr defaults traditional
hostname k8s-controller
log stdout

router bgp 65000
   bgp router-id 172.20.10.1
   neighbor 172.20.10.101 remote-as 65000
   neighbor 172.20.10.102 remote-as 65000

   address-family l2vpn evpn
      advertise-all-vni
      neighbor 172.20.10.101 activate
      neighbor 172.20.10.102 activate
   exit
exit


